rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin"
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // A user can read only their own role document. No client can create,
    // modify, enumerate, or delete admin grants. Project owners manage these
    // documents through Firebase Console / Admin SDK.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /channels/{channelId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          "name", "url", "logo", "referer", "countryCode",
          "countryName", "category", "active", "sortOrder", "updatedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.url is string
        && request.resource.data.url.matches("^https?://.*");
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
