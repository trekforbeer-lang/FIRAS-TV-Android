<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:show_buffering="when_playing"
        app:resize_mode="zoom" />

    <ImageView
        android:id="@+id/channelWatermark"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="22dp"
        android:layout_marginTop="72dp"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:contentDescription="شعار القناة"
        android:background="#33202A3A"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:background="#50101828">

        <Button
            android:id="@+id/playerBackButton"
            android:layout_width="48dp"
            android:layout_height="52dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#00000000"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="38sp" />

        <TextView
            android:id="@+id/channelTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="10dp"
            android:text="اختر قناة"
            android:textColor="#FFFFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <Button
            android:id="@+id/lockButton"
            android:layout_width="48dp"
            android:layout_height="52dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#00000000"
            android:text="♙"
            android:textColor="#FFFFFF"
            android:textSize="25sp" />

        <Button
            android:id="@+id/castButton"
            android:layout_width="48dp"
            android:layout_height="52dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#00000000"
            android:text="◉"
            android:textColor="#FFFFFF"
            android:textSize="25sp" />

        <Button
            android:id="@+id/pictureInPictureButton"
            android:layout_width="48dp"
            android:layout_height="52dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#00000000"
            android:text="▣"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <Button
            android:id="@+id/fullscreenButton"
            android:layout_width="48dp"
            android:layout_height="52dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#00000000"
            android:text="⛶"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

        <Button
            android:id="@+id/qualityButton"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#00000000"
            android:text="HD"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="17sp" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="42dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#00000000"
            android:text="↻"
            android:textColor="#FFFFFF"
            android:textSize="25sp" />

        <Button
            android:id="@+id/serverButton"
            android:layout_width="42dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#00000000"
            android:text="⋯"
            android:textColor="#FFFFFF"
            android:textSize="28sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/centerControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#18000000"
        android:padding="8dp">

        <Button
            android:id="@+id/previousChannelButton"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#00000000"
            android:text="|◀"
            android:textColor="#FFFFFF"
            android:textSize="25sp" />

        <Button
            android:id="@+id/playPauseButton"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#00000000"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="58sp" />

        <Button
            android:id="@+id/nextChannelButton"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#00000000"
            android:text="▶|"
            android:textColor="#FFFFFF"
            android:textSize="25sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="18dp"
        android:background="#50101828">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/liveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="مباشر"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:background="#FFE60032" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:paddingEnd="8dp"
                android:text="RAHMANI • بث مباشر"
                android:textColor="#F2FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="#99FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/subtitleButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:backgroundTint="#00000000"
                android:text="▤  الترجمة والصوت"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <Button
                android:id="@+id/zoomButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:backgroundTint="#00000000"
                android:text="□  نسبة العرض"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <Button
                android:id="@+id/channelListButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:backgroundTint="#00000000"
                android:text="＋  قائمتي"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channelList"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:visibility="gone"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:clipToPadding="false" />
    </LinearLayout>
</FrameLayout>