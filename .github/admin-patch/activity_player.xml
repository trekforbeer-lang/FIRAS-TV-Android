<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070B"
    android:fitsSystemWindows="false"
    android:clipToPadding="false"
    android:clipChildren="false">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="fill"
        android:background="#000000"
        android:fitsSystemWindows="false"
        app:use_controller="false"
        app:show_buffering="never"
        app:resize_mode="zoom"
        app:keep_content_on_player_reset="true" />

    <View
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_gravity="top"
        android:background="@drawable/rahmani_player_top_scrim" />

    <View
        android:layout_width="match_parent"
        android:layout_height="176dp"
        android:layout_gravity="bottom"
        android:background="@drawable/rahmani_player_bottom_scrim" />

    <ProgressBar
        android:id="@+id/loadingIndicator"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="#E8C779"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="top"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="@drawable/rahmani_player_panel"
        android:elevation="8dp">

        <Button
            android:id="@+id/playerBackButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/rahmani_player_icon"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="‹"
            android:textSize="30sp"
            android:textColor="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RAHMANI TV  /  LIVE"
                android:textColor="#D8B86B"
                android:textStyle="bold"
                android:textSize="9sp"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/channelTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="اختر قناة"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:maxLines="1" />
        </LinearLayout>

        <Button
            android:id="@+id/lockButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="7dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/rahmani_player_icon"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="♙"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/fullscreenButton"
            android:layout_width="42dp"
            android:layout_height="40dp"
            android:layout_marginEnd="7dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/rahmani_player_icon"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="⛶"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <Button
            android:id="@+id/qualityButton"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/rahmani_player_chip"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="HD"
            android:textColor="#F0D18A"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/centerControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/rahmani_player_panel"
        android:padding="12dp"
        android:elevation="12dp">

        <Button
            android:id="@+id/previousChannelButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginEnd="16dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/rahmani_player_icon"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="|◀"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/playPauseButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/rahmani_player_primary"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="▶"
            android:textColor="#17130A"
            android:textSize="32sp" />

        <Button
            android:id="@+id/nextChannelButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="16dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/rahmani_player_icon"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="▶|"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:background="@drawable/rahmani_player_panel"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/liveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●  مباشر"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="10sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="@drawable/rahmani_player_chip" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end|center_vertical"
                android:text="RAHMANI TV • بث مباشر"
                android:textColor="#CBD2DC"
                android:textSize="10sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="#28FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/subtitleButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1.15"
                android:layout_marginEnd="5dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="الصوت والترجمة"
                android:textAllCaps="false"
                android:textSize="9sp"
                android:background="@drawable/rahmani_player_chip"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:textColor="#E8EDF5" />

            <Button
                android:id="@+id/zoomButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="ملء الشاشة"
                android:textAllCaps="false"
                android:textSize="9sp"
                android:background="@drawable/rahmani_player_chip"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/channelListButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="0.85"
                android:layout_marginEnd="5dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="القنوات"
                android:textAllCaps="false"
                android:textSize="9sp"
                android:background="@drawable/rahmani_player_chip"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/pictureInPictureButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="0.85"
                android:layout_marginEnd="5dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="مصغّر"
                android:textAllCaps="false"
                android:textSize="9sp"
                android:background="@drawable/rahmani_player_chip"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/retryButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="0.75"
                android:layout_marginEnd="5dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="إعادة"
                android:textAllCaps="false"
                android:textSize="9sp"
                android:background="@drawable/rahmani_player_chip"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/serverButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="0.75"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="المصدر"
                android:textAllCaps="false"
                android:textSize="9sp"
                android:background="@drawable/rahmani_player_chip"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/channelPanel"
        android:layout_width="250dp"
        android:layout_height="match_parent"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="14dp"
        android:layout_marginTop="88dp"
        android:layout_marginBottom="104dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/rahmani_player_panel"
        android:elevation="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical|end"
            android:text="قائمة القنوات"
            android:textColor="#E8C779"
            android:textStyle="bold"
            android:textSize="15sp"
            android:paddingEnd="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channelList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>
</FrameLayout>