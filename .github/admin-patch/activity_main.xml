<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:layoutDirection="rtl"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:id="@+id/drawerMenuButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="☰"
            android:textColor="#D9B45B"
            android:textSize="23sp"
            android:background="@drawable/rahmani_action_button"
            android:contentDescription="فتح القائمة الجانبية"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@null"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/adminSecretTrigger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RAHMANI TV"
                android:textColor="#D9B45B"
                android:textSize="25sp"
                android:textStyle="bold|italic"
                android:letterSpacing="0.06"
                android:layoutDirection="ltr"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="كل ما تحب مشاهدته في مكان واحد"
                android:textColor="#B8B8B8"
                android:textSize="10sp"/>
        </LinearLayout>
        <Button
            android:id="@+id/adminButton"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:minWidth="48dp"
            android:minHeight="42dp"
            android:padding="0dp"
            android:text="⚙"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/rahmani_action_button"
            android:backgroundTint="@null"
            android:contentDescription="لوحة الإدارة"
            android:stateListAnimator="@null"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScrollContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:clipToPadding="false"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <EditText
                android:id="@+id/search"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="7dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/search_bg"
                android:hint="⌕   ابحث عن قناة أو فيلم أو تصنيف"
                android:textColorHint="#A6A6A6"
                android:textColor="#FFFFFF"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="17dp"
                android:paddingEnd="17dp"
                android:textSize="13sp"/>

            <FrameLayout
                android:id="@+id/homeHeroSection"
                android:layout_width="match_parent"
                android:layout_height="316dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/home_hero_bg"
                android:foreground="@drawable/rahmani_card_stroke">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="23dp"
                    android:paddingEnd="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RAHMANI TV  /  PREMIUM STREAMING"
                        android:textColor="#D9B45B"
                        android:textStyle="bold"
                        android:textSize="9sp"
                        android:letterSpacing="0.12"
                        android:layoutDirection="ltr"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="كل الترفيه في مكان واحد"
                        android:textColor="#FFFFFF"
                        android:textSize="27sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="قنوات مباشرة • مباريات • أفلام ومسلسلات"
                        android:textColor="#D0D0D0"
                        android:textSize="12sp"/>
                    <Button
                        android:id="@+id/featuredMoviesButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minHeight="40dp"
                        android:layout_marginTop="14dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="اكتشف المحتوى  ›"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/rahmani_primary_button"
                        android:backgroundTint="@null"
                        android:stateListAnimator="@null"/>
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="21dp"
                android:layout_marginBottom="10dp"
                android:text="ابدأ الاستكشاف"
                android:textColor="#F4F6FB"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/quickLiveButton"
                        android:layout_width="126dp"
                        android:layout_height="88dp"
                        android:layout_marginEnd="9dp"
                        android:gravity="center"
                        android:background="@drawable/rahmani_action_card"
                        android:foreground="@drawable/rahmani_card_stroke"
                        android:text="●  مباشر&#10;القنوات الآن"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"/>
                    <TextView
                        android:id="@+id/quickSportsButton"
                        android:layout_width="118dp"
                        android:layout_height="88dp"
                        android:layout_marginEnd="9dp"
                        android:gravity="center"
                        android:background="@drawable/rahmani_action_card"
                        android:foreground="@drawable/rahmani_card_stroke"
                        android:text="⚽  الرياضة&#10;المباريات"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"/>
                    <TextView
                        android:id="@+id/quickMoviesButton"
                        android:layout_width="118dp"
                        android:layout_height="88dp"
                        android:layout_marginEnd="9dp"
                        android:gravity="center"
                        android:background="@drawable/rahmani_action_card"
                        android:foreground="@drawable/rahmani_card_stroke"
                        android:text="▶  الأفلام&#10;شاهد الآن"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"/>
                    <TextView
                        android:id="@+id/quickAdminButton"
                        android:visibility="gone"
                        android:layout_width="112dp"
                        android:layout_height="76dp"
                        android:gravity="center"
                        android:background="@drawable/rahmani_action_card"
                        android:foreground="@drawable/rahmani_card_stroke"
                        android:text="⚙  الإدارة&#10;إدارة المحتوى"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/homeSportsSection"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_marginTop="14dp"
                android:paddingStart="15dp"
                android:paddingEnd="12dp"
                android:background="@drawable/rahmani_panel_bg"
                android:foreground="@drawable/rahmani_card_stroke">
                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="⚽"
                    android:textSize="22sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/rahmani_icon_tile"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RAHMANI SPORTS"
                        android:textColor="#D9B45B"
                        android:textStyle="bold"
                        android:textSize="9sp"
                        android:letterSpacing="0.08"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="مباريات اليوم والنتائج"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="13sp"/>
                </LinearLayout>
                <Button
                    android:id="@+id/sportsMatchesButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minHeight="38dp"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="المباريات"
                    android:textAllCaps="false"
                    android:textSize="10sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/rahmani_primary_button"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/homeChannelsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="24dp"
                android:paddingBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="تصفّح حسب القسم"
                    android:textColor="#F4F6FB"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="كل الأقسام"
                    android:textColor="#A7A7A7"
                    android:textSize="10sp"/>
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    app:singleLine="true"
                    app:singleSelection="true"
                    app:selectionRequired="true"/>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/channelListSectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="18dp"
                android:paddingBottom="10dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="القنوات المباشرة"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="اختر التصنيف ثم القناة للمشاهدة"
                        android:textColor="#A7A7A7"
                        android:textSize="10sp"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/channelCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="0 قناة"
                    android:textColor="#D9B45B"
                    android:textStyle="bold"
                    android:textSize="11sp"/>
                <Button
                    android:id="@+id/countryPickerButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minHeight="38dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="الدول"
                    android:textAllCaps="false"
                    android:textSize="10sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/rahmani_action_button"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/restoreStatusPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="10dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/rahmani_panel_bg"
                android:visibility="gone">
                <TextView
                    android:id="@+id/restoreStatusTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="استعادة القنوات"
                    android:textColor="#D9B45B"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/restoreStatusDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="سيظهر هنا تقدّم الاستعادة."
                    android:textColor="#B8B8B8"
                    android:textSize="11sp"/>
                <ProgressBar
                    android:id="@+id/restoreStatusProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="12dp"
                    android:indeterminate="true"
                    android:indeterminateTint="#D9B45B"
                    android:progressTint="#D9B45B"
                    android:progressBackgroundTint="#303030"/>
                <Button
                    android:id="@+id/restoreChannelsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minHeight="40dp"
                    android:layout_marginTop="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="استعادة القنوات"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="#111111"
                    android:background="@drawable/rahmani_primary_button"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/channelBrowseLayout"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:orientation="horizontal"
                android:gravity="top"
                android:background="@drawable/rahmani_panel_bg"
                android:padding="8dp">

                <LinearLayout
                    android:id="@+id/categoryRail"
                    android:layout_width="112dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="6dp"
                    android:background="#151515">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:text="التصنيفات"
                        android:textColor="#D9B45B"
                        android:textStyle="bold"
                        android:textSize="12sp"/>
                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:scrollbars="none">
                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="4dp"
                            android:paddingBottom="6dp"
                            app:singleLine="false"
                            app:singleSelection="true"
                            app:selectionRequired="true"
                            app:chipSpacingVertical="7dp"/>
                    </ScrollView>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/channelListContainer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minHeight="230dp">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:nestedScrollingEnabled="true"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="8dp"
                        android:clipToPadding="false"/>
                    <TextView
                        android:id="@+id/empty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="لا توجد قنوات في هذا القسم حالياً"
                        android:textColor="#B8B8B8"
                        android:visibility="gone"/>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottomNavigationBar"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/rahmani_nav_capsule"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:elevation="10dp">
        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/rahmani_nav_item_bg"
            android:text="⌂&#10;الرئيسية"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"/>
        <TextView
            android:id="@+id/navChannels"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/rahmani_nav_item_bg"
            android:text="▣&#10;القنوات"
            android:textColor="#A6A6A6"
            android:textSize="10sp"
            android:clickable="true"
            android:focusable="true"/>
        <TextView
            android:id="@+id/navDiscover"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/rahmani_nav_item_bg"
            android:text="⌕&#10;اكتشف"
            android:textColor="#A6A6A6"
            android:textSize="10sp"
            android:clickable="true"
            android:focusable="true"/>
        <TextView
            android:id="@+id/navMovies"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/rahmani_nav_item_bg"
            android:text="★&#10;قائمتي"
            android:textColor="#A6A6A6"
            android:textSize="10sp"
            android:clickable="true"
            android:focusable="true"/>
        <TextView
            android:id="@+id/navAdmin"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/rahmani_nav_item_bg"
            android:text="☰&#10;المزيد"
            android:textColor="#A6A6A6"
            android:textSize="10sp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone">
        <TextView android:id="@+id/homeModeButton" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/customizeButton" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/fanPreferencesButton" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/homeTab" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/channelsTab" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/sportsTab" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button android:id="@+id/moviesButton" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
