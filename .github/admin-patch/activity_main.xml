<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090909"
    android:layoutDirection="rtl"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:id="@+id/drawerMenuButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="☰"
            android:textColor="#E8C98E"
            android:textSize="23sp"
            android:background="@drawable/rahmani_action_button"
            android:contentDescription="فتح القائمة الجانبية"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@null"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/adminSecretTrigger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RAHMANI TV"
                android:textColor="#D6B879"
                android:textSize="25sp"
                android:textStyle="bold|italic"
                android:letterSpacing="0.06"
                android:layoutDirection="ltr"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="كل ما تحب مشاهدته في مكان واحد"
                android:textColor="#B8B1A0"
                android:textSize="10sp"/>
        </LinearLayout>
        <Button
            android:id="@+id/adminButton"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:minWidth="48dp"
            android:minHeight="42dp"
            android:padding="0dp"
            android:text="⚙"
            android:textSize="17sp"
            android:textColor="#F5F6FA"
            android:background="@drawable/rahmani_action_button"
            android:backgroundTint="@null"
            android:contentDescription="لوحة الإدارة"
            android:stateListAnimator="@null"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScrollContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:clipToPadding="false"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <EditText
                android:id="@+id/search"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="7dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/search_bg"
                android:hint="⌕   ابحث عن قناة أو فيلم أو تصنيف"
                android:textColorHint="#9B9588"
                android:textColor="#FFFFFF"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="17dp"
                android:paddingEnd="17dp"
                android:textSize="13sp"/>

            <FrameLayout
                android:id="@+id/homeHeroSection"
                android:layout_width="match_parent"
                android:layout_height="226dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/home_hero_bg"
                android:foreground="@drawable/rahmani_card_stroke">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="21dp"
                    android:paddingEnd="18dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RAHMANI  /  ENTERTAINMENT"
                        android:textColor="#D6B879"
                        android:textStyle="bold"
                        android:textSize="9sp"
                        android:letterSpacing="0.12"
                        android:layoutDirection="ltr"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="ليلتك تبدأ من هنا"
                        android:textColor="#FFFFFF"
                        android:textSize="29sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="قنوات مباشرة، رياضة وأفلام بواجهة واحدة"
                        android:textColor="#D8D2C4"
                        android:textSize="11sp"/>
                    <Button
                        android:id="@+id/featuredMoviesButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minHeight="40dp"
                        android:layout_marginTop="14dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="اكتشف الأفلام  ›"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/rahmani_primary_button"
                        android:backgroundTint="@null"
                        android:stateListAnimator="@null"/>
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="21dp"
                android:layout_marginBottom="10dp"
                android:text="ابدأ الاستكشاف"
                android:textColor="#F4F6FB"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/quickLiveButton"
                        android:layout_width="122dp"
                        android:layout_height="82dp"
                        android:layout_marginEnd="9dp"
                        android:gravity="center"
                        android:background="@drawable/rahmani_action_card"
                        android:foreground="@drawable/rahmani_card_stroke"
                        android:text="●  مباشر&#10;القنوات الآن"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"/>
                    <TextView
                        android:id="@+id/quickSportsButton"
                        android:layout_width="112dp"
                        android:layout_height="76dp"
                        android:layout_marginEnd="9dp"
                        android:gravity="center"
                        android:background="@drawable/rahmani_action_card"
                        android:foreground="@drawable/rahmani_card_stroke"
                        android:text="⚽  الرياضة&#10;المباريات"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"/>
                    <TextView
                        android:id="@+id/quickMoviesButton"
                        android:layout_width="112dp"
                        android:layout_height="76dp"
                        android:layout_marginEnd="9dp"
                        android:gravity="center"
                        android:background="@drawable/rahmani_action_card"
                        android:foreground="@drawable/rahmani_card_stroke"
                        android:text="▶  الأفلام&#10;شاهد الآن"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"/>
                    <TextView
                        android:id="@+id/quickAdminButton"
                        android:visibility="gone"
                        android:layout_width="112dp"
                        android:layout_height="76dp"
                        android:gravity="center"
                        android:background="@drawable/rahmani_action_card"
                        android:foreground="@drawable/rahmani_card_stroke"
                        android:text="⚙  الإدارة&#10;إدارة المحتوى"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/homeSportsSection"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_marginTop="14dp"
                android:paddingStart="15dp"
                android:paddingEnd="12dp"
                android:background="@drawable/rahmani_panel_bg"
                android:foreground="@drawable/rahmani_card_stroke">
                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="⚽"
                    android:textSize="22sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/rahmani_icon_tile"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RAHMANI SPORTS"
                        android:textColor="#D6B879"
                        android:textStyle="bold"
                        android:textSize="9sp"
                        android:letterSpacing="0.08"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="مباريات اليوم والنتائج"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="13sp"/>
                </LinearLayout>
                <Button
                    android:id="@+id/sportsMatchesButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minHeight="38dp"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="المباريات"
                    android:textAllCaps="false"
                    android:textSize="10sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/rahmani_primary_button"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/homeChannelsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="24dp"
                android:paddingBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="تصفّح حسب القسم"
                    android:textColor="#F4F6FB"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="كل الأقسام"
                    android:textColor="#A0AEC2"
                    android:textSize="10sp"/>
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    app:singleLine="true"
                    app:singleSelection="true"
                    app:selectionRequired="true"/>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/channelListSectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="18dp"
                android:paddingBottom="9dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="القنوات المباشرة"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="اختر قناة وابدأ المشاهدة"
                        android:textColor="#A49C8D"
                        android:textSize="10sp"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/channelCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="0 قناة"
                    android:textColor="#D6B879"
                    android:textStyle="bold"
                    android:textSize="10sp"/>
                <Button
                    android:id="@+id/restoreChannelsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minHeight="40dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="استعادة القنوات"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="#17130B"
                    android:background="@drawable/rahmani_primary_button"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/channelListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="230dp">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp"
                    android:clipToPadding="false"/>
                <TextView
                    android:id="@+id/empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="لا توجد قنوات في هذا القسم حالياً"
                    android:textColor="#B8B1A0"
                    android:visibility="gone"/>
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottomNavigationBar"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/rahmani_nav_capsule"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:elevation="10dp">
        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/rahmani_nav_item_bg"
            android:text="⌂&#10;الرئيسية"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"/>
        <TextView
            android:id="@+id/navChannels"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/rahmani_nav_item_bg"
            android:text="▣&#10;القنوات"
            android:textColor="#A9B5CA"
            android:textSize="10sp"
            android:clickable="true"
            android:focusable="true"/>
        <TextView
            android:id="@+id/navDiscover"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/rahmani_nav_item_bg"
            android:text="⌕&#10;اكتشف"
            android:textColor="#A9B5CA"
            android:textSize="10sp"
            android:clickable="true"
            android:focusable="true"/>
        <TextView
            android:id="@+id/navMovies"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/rahmani_nav_item_bg"
            android:text="★&#10;قائمتي"
            android:textColor="#A9B5CA"
            android:textSize="10sp"
            android:clickable="true"
            android:focusable="true"/>
        <TextView
            android:id="@+id/navAdmin"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/rahmani_nav_item_bg"
            android:text="☰&#10;المزيد"
            android:textColor="#A9B5CA"
            android:textSize="10sp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone">
        <TextView android:id="@+id/homeModeButton" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/customizeButton" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/fanPreferencesButton" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/homeTab" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/channelsTab" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/sportsTab" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button android:id="@+id/moviesButton" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
