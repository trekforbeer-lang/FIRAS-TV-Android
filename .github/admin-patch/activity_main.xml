<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#080B14"
    android:layoutDirection="rtl" android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="14dp" android:paddingEnd="10dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="RAHMANI" android:textColor="#FF6687" android:textSize="23sp"
                android:textStyle="bold" android:letterSpacing="0.05" android:layoutDirection="ltr"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ترفيه • رياضة • بث مباشر" android:textColor="#9AA8C0" android:textSize="10sp"/>
        </LinearLayout>
        <HorizontalScrollView android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:scrollbars="none" android:fillViewport="false"
            android:gravity="center_vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/homeModeButton" android:layout_width="wrap_content"
                    android:layout_height="48dp" android:minWidth="64dp" android:gravity="center"
                    android:contentDescription="اختيار نمط الصفحة الرئيسية" android:paddingStart="10dp"
                    android:paddingEnd="10dp" android:text="نمط العرض" android:textColor="#FFFFFF"
                    android:textSize="11sp" android:background="#29344B" android:clickable="true" android:focusable="true"/>
                <TextView android:id="@+id/customizeButton" android:layout_width="wrap_content"
                    android:layout_height="48dp" android:minWidth="58dp" android:gravity="center"
                    android:paddingStart="9dp" android:paddingEnd="9dp" android:text="تخصيص"
                    android:textColor="#FFFFFF" android:textSize="11sp" android:background="#25252A"
                    android:clickable="true" android:focusable="true"/>
                <TextView android:id="@+id/fanPreferencesButton" android:layout_width="wrap_content"
                    android:layout_height="48dp" android:minWidth="72dp" android:gravity="center"
                    android:paddingStart="9dp" android:paddingEnd="9dp" android:text="اهتماماتي"
                    android:textColor="#FFFFFF" android:textSize="11sp" android:background="#493047"
                    android:clickable="true" android:focusable="true"/>
                <Button android:id="@+id/adminButton" android:layout_width="wrap_content"
                    android:layout_height="44dp" android:minHeight="44dp" android:minWidth="62dp"
                    android:layout_marginStart="6dp" android:text="الإدارة" android:textAllCaps="false"
                    android:textSize="11sp" android:backgroundTint="#29344B" android:textColor="#FFFFFF"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="42dp"
        android:scrollbars="none" android:paddingStart="10dp" android:paddingEnd="10dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/homeTab" android:layout_width="wrap_content" android:layout_height="34dp"
                android:gravity="center" android:text="الرئيسية" android:textColor="#FFFFFF"
                android:textSize="12sp" android:textStyle="bold" android:paddingStart="17dp" android:paddingEnd="17dp"
                android:background="#303047" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/channelsTab" android:layout_width="wrap_content" android:layout_height="34dp"
                android:gravity="center" android:text="القنوات" android:textColor="#A9B5CA"
                android:textSize="12sp" android:paddingStart="17dp" android:paddingEnd="17dp"
                android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/sportsTab" android:layout_width="wrap_content" android:layout_height="34dp"
                android:gravity="center" android:text="⚽ الرياضة" android:textColor="#FF91A8"
                android:textSize="12sp" android:textStyle="bold" android:paddingStart="17dp" android:paddingEnd="17dp"
                android:clickable="true" android:focusable="true"/>
            <Button android:id="@+id/moviesButton" android:layout_width="wrap_content"
                android:layout_height="34dp" android:minHeight="34dp" android:text="الأفلام"
                android:textAllCaps="false" android:textSize="11sp" android:backgroundTint="#29344B"/>
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.core.widget.NestedScrollView android:id="@+id/homeScrollContainer"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="false"
        android:clipToPadding="false" android:scrollbars="vertical">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="vertical">

    <EditText android:id="@+id/search" android:layout_width="match_parent"
        android:layout_height="46dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_marginTop="5dp" android:layout_marginBottom="10dp"
        android:background="@drawable/search_bg" android:hint="⌕  ابحث عن قناة أو فيلم أو تصنيف..."
        android:textColorHint="#8E9BB2" android:textColor="#FFFFFF" android:singleLine="true"
        android:imeOptions="actionSearch" android:inputType="text"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:textSize="13sp"/>

    <FrameLayout android:id="@+id/homeHeroSection" android:layout_width="match_parent" android:layout_height="158dp"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:background="@drawable/home_hero_bg">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center_vertical"
            android:paddingStart="19dp" android:paddingEnd="19dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="RAHMANI  •  عالم الترفيه" android:textColor="#FFC3D0"
                android:textStyle="bold" android:textSize="10sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="عِش أجواء المشاهدة" android:textColor="#FFFFFF"
                android:textSize="23sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="قنوات مباشرة  •  أفلام  •  بطولات كبرى" android:textColor="#D4D9E5"
                android:textSize="11sp" android:layout_marginTop="4dp"/>
            <Button android:id="@+id/featuredMoviesButton" android:layout_width="wrap_content"
                android:layout_height="34dp" android:minHeight="34dp" android:layout_marginTop="7dp"
                android:text="اكتشف الأفلام  ▶" android:textAllCaps="false" android:textSize="10sp"
                android:backgroundTint="#E94F75" android:textColor="#FFFFFF"/>
        </LinearLayout>
    </FrameLayout>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="76dp"
        android:layout_marginTop="9dp" android:scrollbars="none" android:paddingStart="12dp" android:paddingEnd="12dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/quickLiveButton" android:layout_width="94dp" android:layout_height="60dp"
                android:layout_marginEnd="8dp" android:gravity="center"
                android:text="●  مباشر\nالقنوات الآن" android:textColor="#FFFFFF" android:textStyle="bold"
                android:textSize="12sp" android:background="#26364F" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/quickSportsButton" android:layout_width="94dp" android:layout_height="60dp"
                android:layout_marginEnd="8dp" android:gravity="center" android:text="⚽  الرياضة\nالمباريات"
                android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp"
                android:background="#302943" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/quickMoviesButton" android:layout_width="94dp" android:layout_height="60dp"
                android:layout_marginEnd="8dp" android:gravity="center" android:text="▶  الأفلام\nشاهد الآن"
                android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp"
                android:background="#3A2636" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/quickAdminButton" android:layout_width="94dp" android:layout_height="60dp"
                android:gravity="center" android:text="⚙  الإدارة\nقنواتك"
                android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp"
                android:background="#26333A" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout android:id="@+id/homeSportsSection" android:layout_width="match_parent" android:layout_height="70dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp" android:paddingStart="14dp" android:paddingEnd="12dp"
        android:background="#171F31">
        <TextView android:layout_width="42dp" android:layout_height="42dp"
            android:gravity="center" android:text="⚽" android:textSize="23sp"
            android:background="#2D2944"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:paddingStart="11dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="RAHMANI SPORTS" android:textColor="#FF8CA4" android:textStyle="bold" android:textSize="9sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="مباريات اليوم والنتائج" android:textColor="#FFFFFF"
                android:textStyle="bold" android:textSize="13sp" android:layout_marginTop="3dp"/>
        </LinearLayout>
        <Button android:id="@+id/sportsMatchesButton" android:layout_width="wrap_content"
            android:layout_height="35dp" android:minHeight="35dp" android:text="المباريات"
            android:textAllCaps="false" android:textSize="10sp"
            android:backgroundTint="#E94F75" android:textColor="#FFFFFF"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/homeChannelsSection" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="11dp" android:paddingBottom="3dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="تصفّح حسب القسم" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="اسحب لاكتشاف المزيد" android:textColor="#8492A9" android:textSize="9sp"/>
    </LinearLayout>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:scrollbars="none" android:paddingTop="1dp" android:paddingBottom="2dp">
        <com.google.android.material.chip.ChipGroup android:id="@+id/chips"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            app:singleLine="true" app:singleSelection="true" app:selectionRequired="true"/>
    </HorizontalScrollView>

    <LinearLayout android:id="@+id/channelListSectionHeader" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="4dp" android:paddingBottom="6dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="القنوات المباشرة" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="اختر قناتك وابدأ المشاهدة" android:textColor="#8492A9" android:textSize="9sp"/>
        </LinearLayout>
        <TextView android:id="@+id/channelCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="8dp" android:text="0 قناة" android:textColor="#FF91A8" android:textStyle="bold" android:textSize="10sp"/>
        <Button android:id="@+id/restoreChannelsButton" android:layout_width="wrap_content"
            android:layout_height="32dp" android:minHeight="32dp"
            android:text="تحديث القوائم" android:textAllCaps="false" android:textSize="9sp"
            android:backgroundTint="#29344B" android:textColor="#FFFFFF"/>
    </LinearLayout>

    <FrameLayout android:id="@+id/channelListContainer" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="220dp">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/list"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="3dp" android:paddingBottom="8dp" android:clipToPadding="false"/>
        <TextView android:id="@+id/empty" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center"
            android:text="لا توجد قنوات في هذا القسم حالياً" android:textColor="#A7B1C2"
            android:visibility="gone"/>
    </FrameLayout>

      </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp"
        android:orientation="horizontal" android:gravity="center" android:background="#111827"
        android:paddingStart="5dp" android:paddingEnd="5dp">
        <TextView android:id="@+id/navHome" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="⌂\nالرئيسية"
            android:textColor="#FF718D" android:textSize="10sp" android:textStyle="bold"
            android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/navChannels" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="▣\nالقنوات"
            android:textColor="#A9B5CA" android:textSize="10sp" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/navSports" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="⚽\nالرياضة"
            android:textColor="#A9B5CA" android:textSize="10sp" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/navMovies" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="▶\nالأفلام"
            android:textColor="#A9B5CA" android:textSize="10sp" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/navAdmin" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="☰\nالمزيد"
            android:textColor="#A9B5CA" android:textSize="10sp" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
</LinearLayout>