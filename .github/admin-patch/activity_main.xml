<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@color/black" android:layoutDirection="rtl" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="12dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FIRAS TV"
            android:textColor="@color/red" android:textSize="30sp" android:textStyle="bold" android:layoutDirection="ltr" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ULTIMATE EDITION"
            android:textColor="@color/muted" android:textSize="11sp" android:letterSpacing="0.2" android:layoutDirection="ltr" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/adminButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
                android:layout_marginTop="8dp" android:minHeight="44dp" android:text="لوحة الإدارة" android:textAllCaps="false" android:textSize="13sp" />
            <Button android:id="@+id/moviesButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
                android:layout_marginTop="8dp" android:minHeight="44dp" android:text="الأفلام" android:textAllCaps="false" android:textSize="13sp" />
        </LinearLayout>
        <Button android:id="@+id/restoreChannelsButton" android:layout_width="match_parent" android:layout_height="44dp"
            android:layout_marginTop="4dp" android:minHeight="44dp" android:text="استعادة القنوات القديمة" android:textAllCaps="false" android:textSize="13sp" />
        <EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="8dp" android:background="@drawable/search_bg" android:hint="@string/search_hint"
            android:textColorHint="@color/muted" android:textColor="@android:color/white" android:singleLine="true"
            android:imeOptions="actionSearch" android:inputType="text" android:paddingStart="18dp" android:paddingEnd="18dp" android:textSize="15sp" />
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:paddingTop="10dp" android:paddingBottom="4dp">
        <com.google.android.material.chip.ChipGroup android:id="@+id/chips" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingStart="16dp" android:paddingEnd="16dp" app:singleLine="true" app:singleSelection="true" app:selectionRequired="true" />
    </HorizontalScrollView>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent"
            android:padding="10dp" android:clipToPadding="false" />
        <TextView android:id="@+id/empty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
            android:text="@string/empty" android:textColor="@color/muted" android:visibility="gone" />
    </FrameLayout>
</LinearLayout>