<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#080B14"
    android:layoutDirection="rtl" android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="9dp" android:paddingBottom="5dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="FIRAS TV" android:textColor="#FF5575" android:textSize="26sp"
                android:textStyle="bold" android:letterSpacing="0.04" android:layoutDirection="ltr"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="عالمك للمشاهدة والترفيه" android:textColor="#A9B5CA" android:textSize="10sp"/>
        </LinearLayout>
        <Button android:id="@+id/adminButton" android:layout_width="wrap_content"
            android:layout_height="38dp" android:minHeight="38dp" android:text="الإدارة"
            android:textAllCaps="false" android:textSize="11sp"/>
    </LinearLayout>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:scrollbars="none" android:paddingStart="10dp" android:paddingEnd="10dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/homeTab" android:layout_width="wrap_content" android:layout_height="40dp"
                android:gravity="center" android:text="الرئيسية" android:textColor="#FFFFFF"
                android:textSize="13sp" android:textStyle="bold" android:paddingStart="15dp" android:paddingEnd="15dp"
                android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/channelsTab" android:layout_width="wrap_content" android:layout_height="40dp"
                android:gravity="center" android:text="القنوات" android:textColor="#A9B5CA"
                android:textSize="13sp" android:paddingStart="15dp" android:paddingEnd="15dp"
                android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/sportsTab" android:layout_width="wrap_content" android:layout_height="40dp"
                android:gravity="center" android:text="الرياضة" android:textColor="#A9B5CA"
                android:textSize="13sp" android:paddingStart="15dp" android:paddingEnd="15dp"
                android:clickable="true" android:focusable="true"/>
            <Button android:id="@+id/moviesButton" android:layout_width="wrap_content"
                android:layout_height="36dp" android:minHeight="36dp" android:text="الأفلام"
                android:textAllCaps="false" android:textSize="11sp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <EditText android:id="@+id/search" android:layout_width="match_parent"
        android:layout_height="43dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_marginTop="3dp" android:layout_marginBottom="8dp"
        android:background="@drawable/search_bg" android:hint="ابحث عن قناة أو تصنيف..."
        android:textColorHint="#8E9BB2" android:textColor="#FFFFFF" android:singleLine="true"
        android:imeOptions="actionSearch" android:inputType="text"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:textSize="13sp"/>

    <FrameLayout android:layout_width="match_parent" android:layout_height="142dp"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:background="@drawable/home_hero_bg">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center_vertical"
            android:paddingStart="18dp" android:paddingEnd="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="مرحباً بك في FIRAS TV" android:textColor="#FFC3D0"
                android:textStyle="bold" android:textSize="10sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="كل ما تحب.. في مكان واحد" android:textColor="#FFFFFF"
                android:textSize="21sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="قنوات مباشرة • أفلام • رياضة" android:textColor="#D4D9E5"
                android:textSize="11sp" android:layout_marginTop="3dp"/>
            <Button android:id="@+id/featuredMoviesButton" android:layout_width="wrap_content"
                android:layout_height="34dp" android:minHeight="34dp" android:layout_marginTop="6dp"
                android:text="اكتشف الأفلام  ▶" android:textAllCaps="false" android:textSize="10sp"/>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp" android:padding="10dp" android:background="#17243A">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="FIRAS SPORTS" android:textColor="#FF8CA4" android:textStyle="bold" android:textSize="9sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="مباريات اليوم والنتائج المباشرة" android:textColor="#FFFFFF"
                android:textStyle="bold" android:textSize="13sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <Button android:id="@+id/sportsMatchesButton" android:layout_width="wrap_content"
            android:layout_height="34dp" android:minHeight="34dp" android:text="تابع الآن"
            android:textAllCaps="false" android:textSize="10sp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="8dp" android:paddingBottom="1dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="تصفّح حسب القسم" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="اختر القسم" android:textColor="#8492A9" android:textSize="9sp"/>
    </LinearLayout>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:scrollbars="none" android:paddingTop="0dp" android:paddingBottom="1dp">
        <com.google.android.material.chip.ChipGroup android:id="@+id/chips"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            app:singleLine="true" app:singleSelection="true" app:selectionRequired="true"/>
    </HorizontalScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="2dp" android:paddingBottom="5dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="القنوات المباشرة" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="قنواتك المفضلة في متناولك" android:textColor="#8492A9" android:textSize="9sp"/>
        </LinearLayout>
        <Button android:id="@+id/restoreChannelsButton" android:layout_width="wrap_content"
            android:layout_height="32dp" android:minHeight="32dp"
            android:text="تحديث القوائم" android:textAllCaps="false" android:textSize="9sp"/>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/list"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="2dp" android:paddingBottom="6dp" android:clipToPadding="false"/>
        <TextView android:id="@+id/empty" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center"
            android:text="لا توجد قنوات في هذا القسم حالياً" android:textColor="#A7B1C2"
            android:visibility="gone"/>
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center" android:background="#111A29"
        android:paddingStart="8dp" android:paddingEnd="8dp">
        <TextView android:id="@+id/navHome" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="⌂\nالرئيسية"
            android:textColor="#FF718D" android:textSize="10sp" android:textStyle="bold"
            android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/navChannels" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="▣\nالقنوات"
            android:textColor="#A9B5CA" android:textSize="10sp" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/navMovies" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="▶\nالأفلام"
            android:textColor="#A9B5CA" android:textSize="10sp" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/navAdmin" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="☰\nالمزيد"
            android:textColor="#A9B5CA" android:textSize="10sp" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
</LinearLayout>