<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#090A0F"
    android:layoutDirection="rtl" android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp"
        android:paddingTop="12dp" android:paddingBottom="8dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="FIRAS TV" android:textColor="#F0445E" android:textSize="27sp"
                    android:textStyle="bold" android:letterSpacing="0.02" android:layoutDirection="ltr"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="كل الترفيه في مكان واحد" android:textColor="#A7A9B4"
                    android:textSize="11sp" android:layout_marginTop="1dp"/>
            </LinearLayout>
            <Button android:id="@+id/adminButton" android:layout_width="wrap_content"
                android:layout_height="38dp" android:minHeight="38dp" android:text="الإدارة"
                android:textAllCaps="false" android:textSize="12sp"/>
        </LinearLayout>

        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none" android:layout_marginTop="8dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/homeTab" android:layout_width="wrap_content" android:layout_height="42dp"
                    android:gravity="center" android:text="الرئيسية" android:textColor="#FFFFFF"
                    android:textSize="14sp" android:textStyle="bold" android:paddingStart="14dp"
                    android:paddingEnd="14dp" android:clickable="true" android:focusable="true"/>
                <TextView android:id="@+id/channelsTab" android:layout_width="wrap_content" android:layout_height="42dp"
                    android:gravity="center" android:text="القنوات" android:textColor="#B9BBC5"
                    android:textSize="14sp" android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:clickable="true" android:focusable="true"/>
                <Button android:id="@+id/moviesButton" android:layout_width="wrap_content"
                    android:layout_height="38dp" android:minHeight="38dp" android:text="الأفلام"
                    android:textAllCaps="false" android:textSize="12sp"/>
                <TextView android:id="@+id/sportsTab" android:layout_width="wrap_content" android:layout_height="42dp"
                    android:gravity="center" android:text="رياضة" android:textColor="#B9BBC5"
                    android:textSize="14sp" android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:clickable="true" android:focusable="true"/>
            </LinearLayout>
        </HorizontalScrollView>

        <EditText android:id="@+id/search" android:layout_width="match_parent"
            android:layout_height="46dp" android:layout_marginTop="8dp"
            android:background="@drawable/search_bg" android:hint="ابحث عن قناة أو تصنيف..."
            android:textColorHint="#9295A2" android:textColor="#FFFFFF" android:singleLine="true"
            android:imeOptions="actionSearch" android:inputType="text"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:textSize="14sp"/>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="154dp"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_marginTop="2dp" android:layout_marginBottom="10dp"
        android:background="@drawable/home_hero_bg">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center_vertical"
            android:paddingStart="20dp" android:paddingEnd="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="مرحباً بك في FIRAS TV" android:textColor="#FF657A"
                android:textStyle="bold" android:textSize="11sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="شاهد ما تحب، وقتما تحب" android:textColor="#FFFFFF"
                android:textSize="22sp" android:textStyle="bold" android:layout_marginTop="5dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="بث مباشر • أفلام • ترفيه" android:textColor="#D0D1D8"
                android:textSize="12sp" android:layout_marginTop="4dp"/>
            <Button android:id="@+id/featuredMoviesButton" android:layout_width="wrap_content"
                android:layout_height="38dp" android:minHeight="38dp" android:layout_marginTop="8dp"
                android:text="اكتشف الأفلام  ▶" android:textAllCaps="false" android:textSize="12sp"/>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="1dp"
        android:paddingBottom="2dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="تصفّح حسب القسم" android:textColor="#FFFFFF"
            android:textSize="16sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="اختر القسم المناسب" android:textColor="#8F929E" android:textSize="10sp"/>
    </LinearLayout>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:scrollbars="none" android:paddingTop="2dp" android:paddingBottom="6dp">
        <com.google.android.material.chip.ChipGroup android:id="@+id/chips"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            app:singleLine="true" app:singleSelection="true" app:selectionRequired="true"/>
    </HorizontalScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="3dp"
        android:paddingBottom="8dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="القنوات المباشرة" android:textColor="#FFFFFF"
                android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="اختر قناتك وابدأ المشاهدة" android:textColor="#9295A2"
                android:textSize="10sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <Button android:id="@+id/restoreChannelsButton" android:layout_width="wrap_content"
            android:layout_height="36dp" android:minHeight="36dp"
            android:text="تحديث القوائم" android:textAllCaps="false" android:textSize="10sp"/>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/list"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="3dp" android:paddingBottom="10dp"
            android:clipToPadding="false"/>
        <TextView android:id="@+id/empty" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center"
            android:text="لا توجد قنوات في هذا القسم حالياً"
            android:textColor="#A7A8B0" android:visibility="gone"/>
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="62dp"
        android:orientation="horizontal" android:gravity="center"
        android:background="#15161D" android:paddingStart="8dp" android:paddingEnd="8dp">
        <TextView android:id="@+id/navHome" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="⌂\nالرئيسية"
            android:textColor="#FF657A" android:textSize="12sp" android:textStyle="bold"
            android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/navChannels" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="▣\nالقنوات"
            android:textColor="#B7B8C0" android:textSize="12sp"
            android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/navMovies" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="▶\nالأفلام"
            android:textColor="#B7B8C0" android:textSize="12sp"
            android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/navAdmin" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="☰\nالمزيد"
            android:textColor="#B7B8C0" android:textSize="12sp"
            android:clickable="true" android:focusable="true"/>
    </LinearLayout>
</LinearLayout>